# Application
BLOG_APP_NAME=个人博客
BLOG_DEBUG=true

# Security
BLOG_SECRET_KEY=change-me-to-a-random-secret-key
BLOG_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
BLOG_DATABASE_URL=sqlite+aiosqlite:///./data/blog.db

# CORS
BLOG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
BLOG_UPLOAD_DIR=uploads

# Initial admin account (used by the seed script only)
BLOG_INIT_ADMIN_USERNAME=admin
BLOG_INIT_ADMIN_PASSWORD=admin123